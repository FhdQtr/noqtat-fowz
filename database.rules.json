{
  "rules": {
    ".read": false,
    ".write": false,
    "matches": {
      ".indexOn": ["expiresAt"],
      "$code": {
        ".read": "auth != null",
        ".write": false,
        "questionWatch": {
          "$playerId": {
            ".write": "auth != null && (root.child('matchAccess').child($code).child('playerUids').child($playerId).val() === auth.uid || root.child('matches').child($code).child('players').child($playerId).child('authUid').val() === auth.uid)",
            ".validate": "!newData.exists() || ((root.child('matches').child($code).child('state').child('phase').val() === 'question' || root.child('matches').child($code).child('state').child('phase').val() === 'showdown') && newData.hasChildren(['questionId', 'status']) && (newData.child('questionId').isNumber() || newData.child('questionId').isString()) && newData.child('questionId').val() === root.child('matches').child($code).child('state').child('question').child('id').val() && (newData.child('status').val() === 'active' || newData.child('status').val() === 'away') && (!newData.child('awayAt').exists() || newData.child('awayAt').isNumber()))"
          }
        }
      }
    },
    "matchSecrets": {
      ".read": false,
      ".write": false
    },
    "matchAccess": {
      ".read": false,
      ".write": false
    },
    "securityRateLimits": {
      ".read": false,
      ".write": false,
      "$scope": {
        ".indexOn": ["expiresAt"]
      }
    },
    "challengeSecrets": {
      ".read": false,
      ".write": false
    },
    "customTypes": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin == true"
    },
    "customQuestions": {
      ".read": "auth != null && auth.token.admin == true",
      ".write": "auth != null && auth.token.admin == true"
    },
    "admin": {
      ".read": false,
      ".write": false
    }
  }
}
